# URL base da API backend
# Desenvolvimento: /api  (o Vite proxy redireciona para localhost:8000)
# Produção:        http://<IP_OU_DOMINIO>:8000/api
VITE_API_BASE_URL=/api

# Porta do host onde o frontend (nginx) será publicado em produção.
# Padrão: 80. Mude (ex.: 8080) se a 80 já estiver em uso por outro serviço.
FRONTEND_PORT=80
